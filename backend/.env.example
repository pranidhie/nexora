APP_NAME=NEXORA
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5433/nexora

JWT_SECRET_KEY=replace-with-a-secure-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5433,http://127.0.0.1:5433
